<Window x:Class="TreeCadN.kommunikacii.kommunikacii_main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="3D объекты"
        Height="560"
        Width="980"
        MinHeight="500"
        MinWidth="760"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>

        <Style x:Key="CardListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
            <Setter Property="TextSearch.TextPath" Value="name" />
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="tab1"
                    Margin="5"
                    VerticalContentAlignment="Stretch"
                    SelectionChanged="tab1_SelectionChanged">
            <TabItem x:Name="item1" Header="С сервера">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="160" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="6,7"
                               FontWeight="SemiBold"
                               Text="Категории" />

                    <ListBox x:Name="lb3"
                             Grid.Row="1"
                             Margin="0,0,5,0"
                             SelectionChanged="Lb3_SelectionChanged"
                             VerticalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="5,3"
                                           Text="{Binding name}"
                                           ToolTip="{Binding name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding is_all}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1"
                                  Grid.RowSpan="2"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True" />

                    <Grid Grid.Column="2" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Margin="4,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Поиск:" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="serverSearchBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     TextChanged="serverSearchBox_TextChanged" />
                            <TextBlock Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="Поиск от 2 символов">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=serverSearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Label x:Name="label1"
                               Grid.Column="2"
                               Margin="10,0,0,0"
                               Padding="4,2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Content="Выберите объект" />
                    </Grid>

                    <ListBox x:Name="lb4"
                             Grid.Column="2"
                             Grid.Row="1"
                             Style="{StaticResource CardListBoxStyle}"
                             SelectionChanged="lb4_SelectionChanged"
                             PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                             MouseDoubleClick="lb1_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160"
                                            Background="{Binding zvetbg}"
                                            ToolTip="{Binding name}">
                                    <Border Width="150"
                                            Height="150"
                                            Margin="5"
                                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                                        <Image Width="150"
                                               Height="150"
                                               SnapsToDevicePixels="True"
                                               Stretch="Uniform"
                                               Source="{Binding jpgsource}" />
                                    </Border>
                                    <TextBlock Width="150"
                                               Height="48"
                                               Margin="5,0,5,5"
                                               LineHeight="16"
                                               Text="{Binding name}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Новая категория" Click="MenuItem_Click_3" />
                                <MenuItem x:Name="peremestitb_serv" Header="Переместить" />
                                <Separator />
                                <MenuItem Header="Очистить локальную базу данных" Click="MenuItem_Click_8" />
                                <Separator x:Name="delete_server_object_separator" Visibility="Collapsed" />
                                <MenuItem x:Name="delete_server_object"
                                          Header="Удалить с сервера"
                                          Click="MenuItem_Click_5"
                                          Visibility="Collapsed" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="item2" Header="Пользовательские">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="160" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="6,7"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Категории" />
                        <Button Grid.Column="1"
                                Content="Новая категория"
                                Click="Button_Click_5"
                                Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>

                    <ListBox x:Name="lb2"
                             Grid.Row="1"
                             Margin="0,0,5,0"
                             SelectionChanged="lb2_SelectionChanged"
                             PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                             VerticalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Padding="5,3"
                                           Text="{Binding name}"
                                           ToolTip="{Binding name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding is_all}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="deleteLocalCategoryMenuItem"
                                          Header="Удалить категорию"
                                          Click="MenuItem_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <GridSplitter Grid.Column="1"
                                  Grid.RowSpan="2"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True" />

                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="addLocalModelButton"
                                Content="Добавить 3DS-объект"
                                Click="Button_Click"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <Button x:Name="editLocalModelButton"
                                Content="Редактировать"
                                Click="Button_Click_8"
                                Style="{StaticResource ToolbarButtonStyle}" />
                        <TextBlock Margin="10,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="Поиск:" />
                        <Grid>
                            <TextBox x:Name="localSearchBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     TextChanged="localSearchBox_TextChanged" />
                            <TextBlock Margin="11,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="Поиск от 2 символов">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=localSearchBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="allnaserver"
                                Content="Отправить всё на сервер"
                                Click="Button_Click_7"
                                Style="{StaticResource ToolbarButtonStyle}" />
                    </WrapPanel>

                    <ListBox x:Name="lb1"
                             Grid.Column="2"
                             Grid.Row="1"
                             Style="{StaticResource CardListBoxStyle}"
                             SelectionChanged="lb1_SelectionChanged"
                             PreviewMouseRightButtonDown="ListBox_PreviewMouseRightButtonDown"
                             MouseDoubleClick="lb1_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="160" ToolTip="{Binding name}">
                                    <Border Width="150"
                                            Height="150"
                                            Margin="5"
                                            Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
                                        <Image Width="150"
                                               Height="150"
                                               SnapsToDevicePixels="True"
                                               Stretch="Uniform"
                                               Source="{Binding bitmap_prev}" />
                                    </Border>
                                    <TextBlock Width="150"
                                               Height="48"
                                               Margin="5,0,5,5"
                                               LineHeight="16"
                                               Text="{Binding name}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Добавить 3DS-объект" Click="MenuItem_Click_6" />
                                <MenuItem x:Name="sendLocalModelMenuItem"
                                          Header="Отправить на сервер"
                                          Click="MenuItem_Click_7" />
                                <Separator />
                                <MenuItem x:Name="editLocalModelMenuItem"
                                          Header="Редактировать"
                                          Click="MenuItem_Click_1" />
                                <Separator />
                                <MenuItem x:Name="deleteLocalModelMenuItem"
                                          Header="Удалить"
                                          Click="MenuItem_Click_2" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="stpan" Grid.Row="1" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar x:Name="busyProgress"
                             Width="100"
                             Height="14"
                             Margin="5,0,10,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
                <TextBlock x:Name="statusText"
                           VerticalAlignment="Center"
                           Text="Готово" />
            </StackPanel>

            <Button x:Name="okButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Content="Вставить"
                    Click="Button_Click_1"
                    IsDefault="True"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button x:Name="cancelButton"
                    Grid.Column="2"
                    MinWidth="110"
                    Content="Отмена"
                    Click="Button_Click_2"
                    IsCancel="True"
                    Style="{StaticResource ToolbarButtonStyle}" />
        </Grid>
    </Grid>
</Window>
